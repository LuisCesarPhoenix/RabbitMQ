RABBITMQ_VERSION=3.13.0-management
# Define a versão da imagem do RabbitMQ que será usada no build do container.
# A tag "management" garante que a interface de administração via web (RabbitMQ Management Plugin) esteja disponível.

RABBITMQ_DEFAULT_USER=admin
# Nome de usuário padrão que será criado ao iniciar o RabbitMQ.
# Esse usuário é utilizado para login na interface web e para autenticação dos serviços que se conectam ao broker.

RABBITMQ_DEFAULT_PASS=admin
# Senha do usuário padrão especificado acima.
# Assim como o nome de usuário, ela é necessária para acessar o painel de administração e autenticar conexões externas.

RABBITMQ_CONTAINER_NAME=rabbitmq
# Define o nome personalizado do container Docker que será criado para o RabbitMQ.
# Isso facilita comandos como "docker logs rabbitmq" ou "docker exec -it rabbitmq sh".

RABBITMQ_PORT=5672
# Porta padrão para comunicação entre aplicações e o RabbitMQ utilizando o protocolo AMQP (Advanced Message Queuing Protocol).
# É por essa porta que os microserviços, APIs e workers trocam mensagens com a fila.

RABBITMQ_MANAGEMENT_PORT=15672
# Porta usada para acessar a interface web de administração do RabbitMQ.
# Essa interface permite visualizar filas, conexões, exchanges, mensagens, logs e muito mais.


