RABBITMQ_VERSION=3.13.0-management
# Define a versão da imagem do RabbitMQ com interface web (management plugin).

RABBITMQ_DEFAULT_USER=admin
# Define o nome do usuário padrão para autenticação no painel e uso do serviço.

RABBITMQ_DEFAULT_PASS=admin
# Define a senha do usuário padrão para autenticação segura.

RABBITMQ_CONTAINER_NAME=rabbitmq
# Nome do container Docker, usado para facilitar comandos como logs ou exec.

RABBITMQ_PORT=5672
# Porta padrão usada para comunicação entre serviços e o RabbitMQ (protocolo AMQP).

RABBITMQ_MANAGEMENT_PORT=15672
# Porta usada para acessar a interface web de administração do RabbitMQ.

